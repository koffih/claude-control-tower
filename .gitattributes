# Normalise line endings to LF in the repository, on every platform.
#
# Without this, a contributor on Windows with core.autocrlf=true commits CRLF and
# every file they touch shows up as entirely rewritten in the diff. It also puts
# git at odds with .editorconfig and Prettier, which both specify LF.
* text=auto eol=lf

# Binary files must never be normalised.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated, and noisy in review.
package-lock.json linguist-generated=true -diff

# Keep the language statistics honest: tests and fixtures are not the project.
*.test.ts linguist-vendored=false
